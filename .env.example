# Copy this file to .env and edit. Every value here has a matching,
# documented entry in docker-compose.yml and docs/CONFIGURATION.md.
#
#   cp .env.example .env
#
# Nothing in this file is required. `docker compose up -d` with no .env at
# all still works: it pulls the image, generates an admin password on first
# boot (printed once to `docker compose logs`), and starts faxq/hfaxd with
# no modem configured. The block at the bottom is what you'd actually set
# to turn it into a working fax server.

# --- Build pins (docs/BUILD.md) - only read if docker-compose.override.yml
#     is present, i.e. you're building locally instead of pulling ----------
ALPINE_VERSION=3.24.2
ALPINE_DIGEST=sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
HYLAFAX_PKG_VERSION=7.0.11-r0
IAXMODEM_PKG_VERSION=1.3.4-r1

# --- Where to pull from -------------------------------------------------------
# Defaults (docker-compose.yml) already point at the public image GitHub
# Actions publishes: ghcr.io/switzer60/docker-hylafax-plus:latest. Nothing
# below is needed unless you're pulling from a different registry instead:
# REGISTRY=your-registry.example.com
# IMAGE_NAMESPACE=your-namespace
# IMAGE_NAME=docker-hylafax-plus
# IMAGE_TAG=latest
#
# To pin instead of floating on `latest`, use the composite version tag
# (see docs/BUILD.md#tagging) - it only moves when the Alpine/hylafaxplus/
# iaxmodem versions actually change, not on every commit:
# IMAGE_TAG=alpine-3.24.2_hylafaxplus-7.0.11-r0_iaxmodem-1.3.4-r1

TZ=UTC

# --- Identity & dialing ------------------------------------------------------
FAX_COUNTRY_CODE=1
FAX_AREA_CODE=919
FAX_LONG_DISTANCE_PREFIX=1
FAX_INTERNATIONAL_PREFIX=011
FAX_DIAL_RULES=dialrules

# --- hfaxd -------------------------------------------------------------------
HFAXD_ENABLE=yes
HFAXD_PORT=4559
HFAXD_BIND_ADDRESS=0.0.0.0

# --- Access control ------------------------------------------------------------
# Optional. Leave HYLAFAX_ADMIN_PASSWORD blank/unset to get a generated
# password on first boot (see `docker compose logs`) instead of picking one
# here - either way it's persisted, so restarts don't change it.
HYLAFAX_ADMIN_USER=admin
HYLAFAX_ADMIN_PASSWORD=
HYLAFAX_ADMIN_ADMINWORD=
HYLAFAX_ALLOW_HOSTS=

# --- Modems --------------------------------------------------------------------
# Optional - defaults to 0 (no modem; faxq/hfaxd still start). Set to 1 and
# fill in the block below for an actual fax line. See docs/MODEMS.md.
MODEM_COUNT=1

MODEM_1_TYPE=iaxmodem
MODEM_1_DEVICE=ttyIAX0
MODEM_1_FAX_NUMBER=+19195551212
MODEM_1_LOCAL_ID=HylaFAX
# Point this at your Asterisk/FreePBX IAX2 endpoint - see docs/MODEMS.md.
MODEM_1_IAX_SERVER=
MODEM_1_IAX_PEER_NAME=fax1
MODEM_1_IAX_PEER_SECRET=change-me
