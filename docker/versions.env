# Canonical version pins for this build. This is the one file to bump when
# updating hylafax+/Alpine/iaxmodem. docker-compose.yml, docker/Dockerfile,
# and .env.example all carry the same values as their defaults (so a plain
# `docker build` or `docker compose up` with no .env still gets a pinned,
# reproducible image) - scripts/check-versions.sh (run in CI, see
# jenkins/Jenkinsfile) fails the build if they drift apart.
#
# To bump: see docs/BUILD.md#updating-the-pins.

ALPINE_VERSION=3.22
ALPINE_DIGEST=sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
HYLAFAX_PKG_VERSION=7.0.10-r0
IAXMODEM_PKG_VERSION=1.3.4-r0
IMAGE_NAME=hylafax-plus
